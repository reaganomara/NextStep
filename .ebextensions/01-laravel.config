# Elastic Beanstalk settings for the NextStep Laravel app.
# Only non-secret values belong here. APP_KEY is set separately in the
# Elastic Beanstalk console and must never be committed.
option_settings:
  aws:elasticbeanstalk:container:php:phpini:
    document_root: /public
    composer_options: --no-dev --optimize-autoloader
  aws:elasticbeanstalk:application:environment:
    APP_NAME: NextStep
    APP_ENV: production
    APP_DEBUG: "false"
    # Public HTTPS address visitors use (CloudFront). Laravel uses it for
    # links built outside a web request; it does not force any redirect.
    APP_URL: https://dvh5yx5o2vs21.cloudfront.net
    # Browsers reach the site over HTTPS through CloudFront, so session and
    # CSRF cookies are marked Secure. Visiting the Elastic Beanstalk address
    # over plain HTTP will not keep these cookies, so the demos only work
    # through CloudFront.
    SESSION_SECURE_COOKIE: "true"
    # Skip debug and info messages in production logs. The safety override
    # log uses its own "warning" level and is not affected.
    LOG_LEVEL: warning
    SESSION_DRIVER: file
    CACHE_STORE: file
    QUEUE_CONNECTION: sync
