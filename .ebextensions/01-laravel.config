# Elastic Beanstalk settings for the NextStep Laravel app.
# Only non-secret values belong here. APP_KEY is set separately in the
# Elastic Beanstalk console and must never be committed.
option_settings:
  aws:elasticbeanstalk:container:php:phpini:
    document_root: /public
    composer_options: --no-dev --optimize-autoloader
  aws:elasticbeanstalk:application:environment:
    APP_NAME: NextStep
    APP_ENV: production
    APP_DEBUG: "false"
    SESSION_DRIVER: file
    CACHE_STORE: file
    QUEUE_CONNECTION: sync
